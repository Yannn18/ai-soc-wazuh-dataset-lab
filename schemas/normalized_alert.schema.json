{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized Wazuh Alert",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "agent_name",
    "source_ip",
    "destination_ip",
    "rule_id",
    "rule_level",
    "rule_description",
    "rule_groups",
    "raw_event",
    "scenario_id",
    "attack_type",
    "mitre_tactic",
    "mitre_technique",
    "label",
    "confidence",
    "ground_truth_source",
    "alert_source"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt-[a-f0-9]{16}$",
      "description": "Deterministic event ID from stable_id()"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "description": "Wazuh agent name"
    },
    "agent_ip": {
      "type": "string",
      "description": "Wazuh agent IP (may be empty)"
    },
    "source_ip": {
      "type": ["string", "null"],
      "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$",
      "description": "Source IP address (masked in final dataset)"
    },
    "destination_ip": {
      "type": ["string", "null"],
      "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$",
      "description": "Destination IP address (masked in final dataset)"
    },
    "rule_id": {
      "type": "string",
      "description": "Wazuh rule ID as string"
    },
    "rule_level": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 16,
      "description": "Wazuh rule severity level"
    },
    "rule_description": {
      "type": "string",
      "description": "Wazuh rule description"
    },
    "rule_groups": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Wazuh rule groups"
    },
    "raw_event": {
      "type": "string",
      "description": "Original log message or full alert JSON"
    },
    "scenario_id": {
      "type": "string",
      "description": "Scenario identifier from ground truth or builtin mapping"
    },
    "attack_type": {
      "type": "string",
      "enum": [
        "ssh_brute_force",
        "ssh_auth_success",
        "ssh_priv_esc",
        "ssh_lateral",
        "ssh_anomaly",
        "ssh_unknown",
        "web_login_failure",
        "web_input_attack",
        "web_recon",
        "fim_event",
        "suspicious_command",
        "recon",
        "benign_admin",
        "unknown",
        "unmatched"
      ],
      "description": "Normalized attack type"
    },
    "mitre_tactic": {
      "type": "string",
      "description": "MITRE ATT&CK tactic"
    },
    "mitre_technique": {
      "type": "string",
      "pattern": "^(T\\d{4}(\\.\\d{3})?|unknown)$",
      "description": "MITRE ATT&CK technique ID or 'unknown'"
    },
    "label": {
      "type": "string",
      "enum": ["malicious", "benign", "unlabeled"],
      "description": "Binary label"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Correlation confidence score"
    },
    "ground_truth_source": {
      "type": "string",
      "enum": ["ground_truth_correlated", "ground_truth_only", "wazuh_alert_only", "none"],
      "description": "Source of ground truth correlation"
    },
    "alert_source": {
      "type": "string",
      "enum": ["custom_ai_soc", "builtin_ssh", "suricata", "zeek", "other", "unknown"],
      "description": "Source sensor/type of alert"
    },
    "payload_id": {
      "type": ["string", "null"],
      "description": "Payload identifier from custom alerts"
    },
    "tool": {
      "type": ["string", "null"],
      "description": "Tool used in attack scenario"
    },
    "intensity": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null],
      "description": "Attack intensity"
    },
    "ssh_user": {
      "type": ["string", "null"],
      "description": "SSH username from builtin alerts"
    },
    "ssh_srcport": {
      "type": ["string", "null"],
      "description": "SSH source port"
    },
    "ssh_dstport": {
      "type": ["string", "null"],
      "description": "SSH destination port"
    },
    "ssh_protocol": {
      "type": ["string", "null"],
      "description": "SSH protocol version"
    }
  },
  "additionalProperties": false
}