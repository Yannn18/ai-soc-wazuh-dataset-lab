{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI SOC Wazuh Dataset",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "agent_name",
    "source_ip",
    "destination_ip",
    "rule_id",
    "rule_level",
    "rule_description",
    "full_log",
    "scenario_id",
    "run_id",
    "attack_type",
    "mitre_tactic",
    "mitre_technique",
    "label",
    "confidence",
    "ground_truth_source",
    "correlation_status",
    "feature_full_log_length",
    "feature_full_log_entropy",
    "feature_event_count_source_ip",
    "feature_event_count_agent",
    "feature_event_count_rule",
    "feature_event_count_minute",
    "feature_minute_bucket",
    "feature_status_code",
    "feature_user_agent_category",
    "feature_rule_level",
    "feature_is_high_severity",
    "feature_has_mitre",
    "binary_label",
    "multi_class_label",
    "source_of_truth"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^final-[a-f0-9]{16}$|^evt-[a-f0-9]{16}$|^final-unmatched-[a-f0-9]{16}$",
      "description": "Deterministic event ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "description": "Wazuh agent name (sanitized to 'unknown' if missing)"
    },
    "source_ip": {
      "type": ["string", "null"],
      "pattern": "^(\\d{1,3}\\.){3}(\\d{1,3}|X)$|^[a-zA-Z0-9.-]+$",
      "description": "Source IP address (masked: last octet = X) or hostname"
    },
    "destination_ip": {
      "type": ["string", "null"],
      "pattern": "^(\\d{1,3}\\.){3}(\\d{1,3}|X)$|^[a-zA-Z0-9.-]+$",
      "description": "Destination IP address (masked: last octet = X) or hostname"
    },
    "rule_id": {
      "type": "string",
      "description": "Wazuh rule ID as string"
    },
    "rule_level": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 16,
      "description": "Wazuh rule severity level"
    },
    "rule_description": {
      "type": "string",
      "description": "Wazuh rule description (sanitized)"
    },
    "full_log": {
      "type": "string",
      "description": "Original log message or full alert JSON (sanitized)"
    },
    "scenario_id": {
      "type": "string",
      "description": "Scenario identifier from ground truth or builtin mapping"
    },
    "run_id": {
      "type": "string",
      "description": "Orchestrator run identifier"
    },
    "attack_type": {
      "type": "string",
      "enum": [
        "ssh_brute_force",
        "ssh_auth_success",
        "ssh_priv_esc",
        "ssh_lateral",
        "ssh_anomaly",
        "ssh_unknown",
        "web_login_failure",
        "web_input_attack",
        "web_recon",
        "fim_event",
        "suspicious_command",
        "recon",
        "benign_admin",
        "auth_attack",
        "benign",
        "web_attack",
        "unknown",
        "unmatched"
      ],
      "description": "Normalized attack type"
    },
    "mitre_tactic": {
      "type": "string",
      "description": "MITRE ATT&CK tactic"
    },
    "mitre_technique": {
      "type": "string",
      "description": "MITRE ATT&CK technique ID or technique name"
    },
    "label": {
      "type": "string",
      "enum": [
        "malicious",
        "benign",
        "unlabeled",
        "recon",
        "web_fingerprint",
        "vuln_scan_light"
      ],
      "description": "Base label from correlation (includes scenario-specific labels for ground truth)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Correlation confidence score"
    },
    "ground_truth_source": {
      "type": "string",
      "enum": ["ground_truth_correlated", "ground_truth_only", "wazuh_alert_only", "none"],
      "description": "Source of ground truth correlation"
    },
    "correlation_status": {
      "type": "string",
      "enum": ["matched_alert", "ground_truth_without_alert", "alert_without_ground_truth"],
      "description": "Correlation status between alert and ground truth"
    },
    "feature_full_log_length": {
      "type": "integer",
      "minimum": 0,
      "description": "Length of full_log string"
    },
    "feature_full_log_entropy": {
      "type": "number",
      "minimum": 0.0,
      "description": "Shannon entropy of full_log"
    },
    "feature_event_count_source_ip": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of events from same source_ip in dataset"
    },
    "feature_event_count_agent": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of events from same agent in dataset"
    },
    "feature_event_count_rule": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of events with same rule_id in dataset"
    },
    "feature_event_count_minute": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of events in same minute bucket"
    },
    "feature_minute_bucket": {
      "type": "string",
      "description": "Minute bucket timestamp (YYYY-MM-DDTHH:MMZ)"
    },
    "feature_status_code": {
      "type": ["integer", "null"],
      "description": "HTTP status code if applicable"
    },
    "feature_user_agent_category": {
      "type": "string",
      "enum": ["browser", "curl", "python_requests", "ssh", "other", "unknown"],
      "description": "Categorized user agent"
    },
    "feature_rule_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16,
      "description": "Rule level as integer feature"
    },
    "feature_is_high_severity": {
      "type": "integer",
      "enum": [0, 1],
      "description": "1 if rule_level >= 7, else 0"
    },
    "feature_has_mitre": {
      "type": "integer",
      "enum": [0, 1],
      "description": "1 if mitre_technique != 'unknown', else 0"
    },
    "binary_label": {
      "type": "string",
      "enum": ["malicious", "benign", "unlabeled"],
      "description": "Final binary classification label"
    },
    "multi_class_label": {
      "type": "string",
      "enum": [
        "unknown",
        "benign",
        "recon",
        "auth_attack",
        "web_attack",
        "suspicious_command",
        "fim_event",
        "ssh_brute_force",
        "ssh_auth_success",
        "ssh_priv_esc",
        "ssh_lateral"
      ],
      "description": "Final multi-class label"
    },
    "source_of_truth": {
      "type": "string",
      "enum": ["ground_truth_correlated", "ground_truth_only", "wazuh_alert_only"],
      "description": "Primary source of truth for this record"
    }
  },
  "additionalProperties": false
}