<group name="ai_soc_dataset,">

  <rule id="110000" level="3">
    <decoded_as>ai-soc-pentest</decoded_as>
    <description>AI SOC dataset custom pentest event</description>
    <group>ai_soc_dataset,custom_pentest,</group>
  </rule>

  <rule id="110010" level="5">
    <if_sid>110000</if_sid>
    <field name="attack_type">^recon$</field>
    <description>AI SOC dataset recon scenario: $(scenario_id)</description>
    <group>ai_soc_dataset,recon,</group>
    <mitre>
      <id>T1595</id>
      </mitre>
  </rule>

  <rule id="110020" level="7">
    <if_sid>110000</if_sid>
    <field name="attack_type">^auth_attack$</field>
    <description>AI SOC dataset authentication attack scenario: $(scenario_id)</description>
    <group>ai_soc_dataset,authentication_failed,auth_attack,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="110030" level="7">
    <if_sid>110000</if_sid>
    <field name="attack_type">^web_attack$</field>
    <description>AI SOC dataset web attack dummy scenario: $(scenario_id)</description>
    <group>ai_soc_dataset,web_attack,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="110040" level="6">
    <if_sid>110000</if_sid>
    <field name="attack_type">^fim_event$</field>
    <description>AI SOC dataset file integrity scenario: $(scenario_id)</description>
    <group>ai_soc_dataset,fim_event,</group>
    <mitre>
      <id>T1222</id>
    </mitre>
  </rule>

  <rule id="110050" level="5">
    <if_sid>110000</if_sid>
    <field name="attack_type">^suspicious_command$</field>
    <description>AI SOC dataset suspicious command scenario: $(scenario_id)</description>
    <group>ai_soc_dataset,suspicious_command,</group>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>

  <rule id="110090" level="1">
    <if_sid>110000</if_sid>
    <field name="expected_label">^benign$</field>
    <description>AI SOC dataset benign lab event: $(scenario_id)</description>
    <group>ai_soc_dataset,benign_lab_event,</group>
  </rule>

</group>
